<section class="jd-hero" id="jd-hero-{{ section.id }}" style="background-color:{{ section.settings.section_bg }};padding:{{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;"><div class="jd-hero__wrap"><div class="jd-hero__left" style="background-color:{{ section.settings.left_bg }};border-radius:{{ section.settings.border_radius }}px;"><div class="jd-hero__left-inner">{%- if section.settings.heading != blank -%}<{{ section.settings.heading_tag }} class="jd-hero__heading" style="color:{{ section.settings.heading_color }};font-size:{{ section.settings.heading_size }}px;">{{ section.settings.heading }}</{{ section.settings.heading_tag }}>{%- endif -%}{%- if section.settings.subtext != blank -%}<div class="jd-hero__subtext" style="color:{{ section.settings.subtext_color }};font-size:{{ section.settings.subtext_size }}px;">{{ section.settings.subtext }}</div>{%- endif -%}{%- if section.settings.btn_label != blank -%}<a class="jd-hero__btn" href="{{ section.settings.btn_link | default: '#' }}" style="background-color:{{ section.settings.btn_bg }};color:{{ section.settings.btn_text_color }};border-radius:{{ section.settings.btn_radius }}px;font-size:{{ section.settings.btn_font_size }}px;">{{ section.settings.btn_label }}{%- if section.settings.btn_arrow -%}&nbsp;&rarr;{%- endif -%}</a>{%- endif -%}</div></div><div class="jd-hero__center" style="border-radius:{{ section.settings.border_radius }}px;overflow:hidden;">{%- if section.settings.hero_image != blank -%}<img src="{{ section.settings.hero_image | image_url: width: 900 }}" alt="{{ section.settings.hero_image.alt | escape }}" class="jd-hero__center-img" loading="eager">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'jd-hero__placeholder' }}{%- endif -%}</div><div class="jd-hero__right">{%- for block in section.blocks -%}{%- if block.type == 'category_card' -%}<div class="jd-hero__card" style="background-color:{{ block.settings.card_bg }};border-radius:{{ section.settings.border_radius }}px;" {{ block.shopify_attributes }}><div class="jd-hero__card-content">{%- if block.settings.card_title != blank -%}<h3 class="jd-hero__card-title" style="color:{{ block.settings.card_title_color }};font-size:{{ block.settings.card_title_size }}px;">{{ block.settings.card_title }}</h3>{%- endif -%}{%- if block.settings.card_desc != blank -%}<p class="jd-hero__card-desc" style="color:{{ block.settings.card_desc_color }};font-size:{{ block.settings.card_desc_size }}px;">{{ block.settings.card_desc }}</p>{%- endif -%}{%- if block.settings.card_btn_label != blank -%}<a class="jd-hero__card-btn" href="{{ block.settings.card_btn_link | default: '#' }}" style="background-color:{{ block.settings.card_btn_bg }};color:{{ block.settings.card_btn_text_color }};border-radius:{{ section.settings.btn_radius }}px;font-size:{{ block.settings.card_btn_font_size }}px;">{{ block.settings.card_btn_label }}{%- if block.settings.card_btn_arrow -%}&nbsp;&rarr;{%- endif -%}</a>{%- endif -%}</div><div class="jd-hero__card-img-wrap">{%- if block.settings.card_image != blank -%}<img src="{{ block.settings.card_image | image_url: width: 320 }}" alt="{{ block.settings.card_image.alt | escape }}" class="jd-hero__card-img" loading="lazy">{%- else -%}{{ 'product-1' | placeholder_svg_tag: 'jd-hero__card-placeholder' }}{%- endif -%}</div></div>{%- endif -%}{%- endfor -%}</div></div></section> %} %} %} }} %} }} }}"> %}" }}"> %} %} %} }}" }} }} }} }} }}"> %} %} }}" }} }}"> %} %} }}> }}" }} }}" }}> %}" }} }}">" }} }} }} }}">

<style>
    #jd-hero-{{ section.id }}{box-sizing:border-box;}
    #jd-hero-{{ section.id }} *,#jd-hero-{{ section.id }} *::before,#jd-hero-{{ section.id }} *::after{box-sizing:inherit;}
    #jd-hero-{{ section.id }} .jd-hero__wrap{display:grid;grid-template-columns:1fr 1.35fr 0.95fr;gap:{{ section.settings.gap }}px;max-width:{{ section.settings.max_width }}px;margin:0 auto;padding:0 20px;align-items:stretch;min-height:{{ section.settings.min_height }}px;}
    #jd-hero-{{ section.id }} .jd-hero__left{display:flex;align-items:center;}
    #jd-hero-{{ section.id }} .jd-hero__left-inner{padding:36px 30px;display:flex;flex-direction:column;gap:18px;width:100%;}
    #jd-hero-{{ section.id }} .jd-hero__heading{font-weight:800;line-height:1.12;text-transform:uppercase;margin:0;}
    #jd-hero-{{ section.id }} .jd-hero__subtext{line-height:1.65;margin:0;}
    #jd-hero-{{ section.id }} .jd-hero__subtext a{color:{{ section.settings.subtext_link_color }};text-decoration:none;}
    #jd-hero-{{ section.id }} .jd-hero__btn{display:inline-flex;align-items:center;padding:14px 28px;font-weight:700;text-decoration:none;transition:opacity .22s,transform .18s;align-self:flex-start;white-space:nowrap;cursor:pointer;}
    #jd-hero-{{ section.id }} .jd-hero__btn:hover{opacity:.87;transform:translateY(-1px);}
    #jd-hero-{{ section.id }} .jd-hero__center{position:relative;min-height:300px;}
    #jd-hero-{{ section.id }} .jd-hero__center-img{width:100%;height:100%;object-fit:cover;display:block;}
    #jd-hero-{{ section.id }} .jd-hero__placeholder{width:100%;height:100%;background:#e0d8c8;display:block;}
    #jd-hero-{{ section.id }} .jd-hero__right{display:flex;flex-direction:column;gap:{{ section.settings.gap }}px;}
    #jd-hero-{{ section.id }} .jd-hero__card{flex:1;display:flex;flex-direction:row;overflow:hidden;align-items:stretch;}
    #jd-hero-{{ section.id }} .jd-hero__card-content{flex:1.15;padding:22px 18px 22px 22px;display:flex;flex-direction:column;justify-content:center;gap:10px;}
    #jd-hero-{{ section.id }} .jd-hero__card-title{font-weight:700;line-height:1.25;margin:0;}
    #jd-hero-{{ section.id }} .jd-hero__card-desc{line-height:1.55;margin:0;}
    #jd-hero-{{ section.id }} .jd-hero__card-btn{display:inline-flex;align-items:center;padding:11px 20px;font-weight:700;text-decoration:none;transition:opacity .22s,transform .18s;align-self:flex-start;white-space:nowrap;cursor:pointer;margin-top:4px;}
    #jd-hero-{{ section.id }} .jd-hero__card-btn:hover{opacity:.87;transform:translateY(-1px);}
    #jd-hero-{{ section.id }} .jd-hero__card-img-wrap{flex:0 0 45%;display:flex;align-items:center;justify-content:flex-end;padding:10px 10px 10px 0;overflow:hidden;}
    #jd-hero-{{ section.id }} .jd-hero__card-img{max-width:100%;max-height:170px;width:auto;height:auto;object-fit:contain;display:block;border-radius:6px;}
    @media screen and (max-width:1024px){#jd-hero-{{ section.id }} .jd-hero__wrap{grid-template-columns:1fr 1fr;grid-template-rows:auto auto;}#jd-hero-{{ section.id }} .jd-hero__center{order:-1;grid-column:1/-1;min-height:280px;}#jd-hero-{{ section.id }} .jd-hero__left{grid-column:1/2;}#jd-hero-{{ section.id }} .jd-hero__right{grid-column:2/3;}}
    @media screen and (max-width:700px){#jd-hero-{{ section.id }} .jd-hero__wrap{grid-template-columns:1fr;padding:0 14px;}#jd-hero-{{ section.id }} .jd-hero__center,#jd-hero-{{ section.id }} .jd-hero__left,#jd-hero-{{ section.id }} .jd-hero__right{grid-column:1;}}
    @media screen and (max-width:480px){#jd-hero-{{ section.id }} .jd-hero__card{flex-direction:column;}#jd-hero-{{ section.id }} .jd-hero__card-img-wrap{flex:unset;justify-content:center;padding:0 12px 14px;}#jd-hero-{{ section.id }} .jd-hero__card-img{max-height:130px;}}
    </style>

    {% schema %}
    {
      "name": "JD Hero Section",
        "tag": "section",
          "class": "jd-hero-section",
            "disabled_on": {"groups": ["header","footer"]},
              "settings": [
                  {"type":"header","content":"Layout"},
                      {"type":"range","id":"max_width","label":"Max Width (px)","min":900,"max":1600,"step":20,"default":1400},
                          {"type":"range","id":"min_height","label":"Min Height (px)","min":200,"max":700,"step":10,"default":420},
                              {"type":"range","id":"gap","label":"Grid Gap (px)","min":4,"max":40,"step":2,"default":16},
                                  {"type":"range","id":"border_radius","label":"Border Radius (px)","min":0,"max":32,"step":2,"default":16},
                                      {"type":"range","id":"section_padding_top","label":"Padding Top (px)","min":0,"max":100,"step":4,"default":24},
                                          {"type":"range","id":"section_padding_bottom","label":"Padding Bottom (px)","min":0,"max":100,"step":4,"default":24},
                                              {"type":"color","id":"section_bg","label":"Section Background","default":"#ffffff"},
                                                  {"type":"header","content":"Left Panel"},
                                                      {"type":"color","id":"left_bg","label":"Left Panel Background","default":"#f5f0e8"},
                                                          {"type":"select","id":"heading_tag","label":"Heading Tag","options":[{"value":"h1","label":"H1"},{"value":"h2","label":"H2"},{"value":"h3","label":"H3"}],"default":"h1"},
                                                              {"type":"textarea","id":"heading","label":"Main Heading","default":"BIENVENUE GROSSISTE ALIMENTAIRE MIAMLAND DEPUIS 10 ANS"},
                                                                  {"type":"color","id":"heading_color","label":"Heading Color","default":"#1a8a7a"},
                                                                      {"type":"range","id":"heading_size","label":"Heading Font Size (px)","min":16,"max":60,"step":1,"default":30},
                                                                          {"type":"richtext","id":"subtext","label":"Subtext Description","default":"<p>Que vous soyez un particulier ou un professionnel, faites votre choix parmi de nombreuses references et marques dans le monde</p>"},
                                                                              {"type":"color","id":"subtext_color","label":"Subtext Color","default":"#555555"},
                                                                                  {"type":"color","id":"subtext_link_color","label":"Subtext Link Color","default":"#e05c20"},
                                                                                      {"type":"range","id":"subtext_size","label":"Subtext Font Size (px)","min":10,"max":22,"step":1,"default":14},
                                                                                          {"type":"text","id":"btn_label","label":"CTA Button Label","default":"Acceder a la boutique"},
                                                                                              {"type":"url","id":"btn_link","label":"CTA Button Link"},
                                                                                                  {"type":"color","id":"btn_bg","label":"CTA Button Background","default":"#e63c1e"},
                                                                                                      {"type":"color","id":"btn_text_color","label":"CTA Button Text Color","default":"#ffffff"},
                                                                                                          {"type":"range","id":"btn_font_size","label":"CTA Button Font Size (px)","min":10,"max":22,"step":1,"default":15},
                                                                                                              {"type":"range","id":"btn_radius","label":"Button Border Radius (px)","min":0,"max":40,"step":2,"default":8},
                                                                                                                  {"type":"checkbox","id":"btn_arrow","label":"Show Arrow","default":true},
                                                                                                                      {"type":"header","content":"Center Image"},
                                                                                                                          {"type":"image_picker","id":"hero_image","label":"Hero Center Image"}
                                                                                                                            ],
                                                                                                                              "blocks": [
                                                                                                                                  {
                                                                                                                                        "type": "category_card",
                                                                                                                                              "name": "Category Card",
                                                                                                                                                    "limit": 4,
                                                                                                                                                          "settings": [
                                                                                                                                                                  {"type":"color","id":"card_bg","label":"Card Background","default":"#f5f0e8"},
                                                                                                                                                                          {"type":"text","id":"card_title","label":"Card Title","default":"Epicerie salee"},
                                                                                                                                                                                  {"type":"color","id":"card_title_color","label":"Card Title Color","default":"#1a8a7a"},
                                                                                                                                                                                          {"type":"range","id":"card_title_size","label":"Card Title Size (px)","min":12,"max":30,"step":1,"default":18},
                                                                                                                                                                                                  {"type":"text","id":"card_desc","label":"Card Description","default":"Decouvrez notre selection"},
                                                                                                                                                                                                          {"type":"color","id":"card_desc_color","label":"Card Desc Color","default":"#555555"},
                                                                                                                                                                                                                  {"type":"range","id":"card_desc_size","label":"Card Desc Size (px)","min":10,"max":20,"step":1,"default":13},
                                                                                                                                                                                                                          {"type":"text","id":"card_btn_label","label":"Card Button Label","default":"Je decouvre"},
                                                                                                                                                                                                                                  {"type":"url","id":"card_btn_link","label":"Card Button Link"},
                                                                                                                                                                                                                                          {"type":"color","id":"card_btn_bg","label":"Card Button Background","default":"#e63c1e"},
                                                                                                                                                                                                                                                  {"type":"color","id":"card_btn_text_color","label":"Card Button Text Color","default":"#ffffff"},
                                                                                                                                                                                                                                                          {"type":"range","id":"card_btn_font_size","label":"Card Button Size (px)","min":10,"max":20,"step":1,"default":13},
                                                                                                                                                                                                                                                                  {"type":"checkbox","id":"card_btn_arrow","label":"Show Arrow","default":true},
                                                                                                                                                                                                                                                                          {"type":"image_picker","id":"card_image","label":"Card Image"}
                                                                                                                                                                                                                                                                                ]
                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                      ],
                                                                                                                                                                                                                                                                                        "presets": [
                                                                                                                                                                                                                                                                                            {
                                                                                                                                                                                                                                                                                                  "name": "JD Hero Section",
                                                                                                                                                                                                                                                                                                        "blocks": [
                                                                                                                                                                                                                                                                                                                {"type":"category_card","settings":{"card_title":"Epicerie salee","card_desc":"Decouvrez notre selection de produits d epicerie","card_btn_label":"Je decouvre"}},
                                                                                                                                                                                                                                                                                                                        {"type":"category_card","settings":{"card_title":"Boissons","card_desc":"Plongez dans l univers de nos boissons","card_btn_label":"Je decouvre"}}
                                                                                                                                                                                                                                                                                                                              ]
                                                                                                                                                                                                                                                                                                                                  }
                                                                                                                                                                                                                                                                                                                                    ]
                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                    {% endschema %}

                                                                                                                                                                                                                                                                                                                    